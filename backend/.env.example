# ==========================================
# Multi-PDF RAG Chat System - FREE SETUP
# ==========================================
# Uses Google Gemini API — completely FREE, no credit card!
# Get your free key at: https://aistudio.google.com/apikey
# Takes 30 seconds — just sign in with Google and click "Get API Key"

# ----- REQUIRED (FREE) -----
GOOGLE_API_KEY=your-google-gemini-api-key-here

# Secret key for sessions
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# ----- DATABASE -----
# SQLite for local dev (zero setup)
DATABASE_URL=sqlite:///./rag_app.db

# PostgreSQL for production (Render/Supabase free tier)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ----- OPTIONAL SETTINGS -----
DEBUG=false
MAX_PDF_SIZE_MB=50
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads

# Free tier Gemini models
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# CORS — add your frontend URL here when deploying
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
